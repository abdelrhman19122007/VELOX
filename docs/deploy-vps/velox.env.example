# VELOX — إعدادات السيرفر (Environment variables)
# دي نسخة من غير أسرار. النسخة الحقيقية نبيه هيبعتهالك لوحدها.
# السيرفر بيقرا الملف ده بنفسه: --spring.config.import=file:/www/velox/velox.env[.properties]

# ---- قاعدة البيانات (Supabase) ----
DB_URL=jdbc:postgresql://aws-0-eu-north-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=<من نبيه>
DB_PASSWORD=<من نبيه>

# ---- الأمان ----
# مفتاح توقيع تسجيل الدخول: 32 حرف عشوائي على الأقل
VELOX_TOKEN_SECRET=<من نبيه>
# صفحة Swagger مقفولة على السيرفر الحقيقي
VELOX_API_DOCS=false
# الدفع الأونلاين التجريبي مقفول (كاش بس)
velox.payments.sandbox=false
# العنوان اللي الموقع بيفتح منه (غيّره لو فيه دومين، مثلاً https://velox.example.com)
VELOX_CORS=http://169.58.19.62

# ---- مكان ملفات الموقع (نبيه بيرفعهم بالـ FTP) ----
# <SITE> = مسار فولدر الموقع المربوط بحساب FTP nabeeh_abosalem، مثلاً /www/wwwroot/169.58.19.62
velox.web.dir=<SITE>/web
velox.app.dir=<SITE>/app
# الصور المرفوعة (فولدر برّه الموقع، يتعمل مرة واحدة)
velox.uploads.dir=/www/velox-data/uploads

# ---- السيرفر ----
PORT=8080
