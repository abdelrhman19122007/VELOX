  "item": [
    {
      "name": "1. Public catalogue",
      "item": [
        {
          "name": "Zones",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/zones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "zones"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Samannoud exists\", () => pm.expect(pm.response.json().map(z => z.code)).to.include(\"SAMANNOUD\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stores",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stores"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test(\"array\", () => pm.expect(s).to.be.an(\"array\"));",
                  "if (s.length) pm.collectionVariables.set(\"storeId\", s[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Store detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{storeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stores",
                "{{storeId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json().sections.flatMap(x => x.products).filter(p => p.available);",
                  "if (p.length) pm.collectionVariables.set(\"productId\", p[0].id);"
                ]
              }
            }
          ]
        },
